APP_NAME=Stock Predictor API
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stockdb
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email alerts (Phase 13) -- Gmail SMTP. SMTP_PASSWORD must be a 16-char
# Gmail "App Password" (myaccount.google.com/apppasswords), NOT your
# regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Telegram alerts (Phase 13) -- create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
